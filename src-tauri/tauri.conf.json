{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonic Player",
  "version": "0.1.0",
  "identifier": "dev.tonicplayer.desktop",
  "build": {
    "beforeDevCommand": "pnpm fetch:ffmpeg --if-missing && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch:ffmpeg --if-missing && pnpm notices && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tonic Player",
        "width": 960,
        "height": 540,
        "minWidth": 240,
        "minHeight": 135,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "category": "Video",
    "shortDescription": "Video player for files and torrents, with Chromecast",
    "copyright": "Copyright © 2026 Daniele",
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "mkv",
          "webm",
          "avi",
          "ts",
          "m2ts",
          "mts",
          "wmv",
          "flv",
          "mpg",
          "mpeg",
          "ogv",
          "3gp"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "torrent"
        ],
        "name": "Torrent",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMTJERTFCMjc0RDI4QTgKUldTb0tFMG5HOTRTTHRld2ZqMk9TOE5BSE9PNExIQmJLL0ZGek94NFU3ZWZmQmlvOUxMZUt0elYK",
      "endpoints": [
        "https://github.com/lupodevelop/tonic-player/releases/latest/download/latest.json"
      ]
    }
  }
}
