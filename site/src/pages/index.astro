---
import Base from '../layouts/Base.astro';
import BottleArt from '../components/BottleArt.astro';
import Icon from '../components/Icon.astro';
import Demo from '../components/Demo.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/lupodevelop/tonic-player';
const latest = `${repo}/releases/latest`;

type Feature = { icon: Parameters<typeof Icon>[0]['name']; title: string; text: string };
const groups: { name: string; items: Feature[] }[] = [
  {
    name: 'Play',
    items: [
      { icon: 'drop', title: 'Drop and play', text: 'Drop a video, a folder or a .torrent on the window. Magnet links open from the browser.' },
      { icon: 'stream', title: 'Torrents while they download', text: 'Playback starts before the download ends; folders and multi-video torrents show a list.' },
      { icon: 'film', title: 'Any format', text: 'MKV, AVI and others are converted on the fly, on the GPU where there is one, with free seeking.' },
    ],
  },
  {
    name: 'Watch your way',
    items: [
      { icon: 'globe', title: '360° and 180° video', text: 'Drag to look around, or watch one eye flat.' },
      { icon: 'cast', title: 'Chromecast', text: 'The control bar drives the device; when the cast ends, playback goes on in the window.' },
      { icon: 'airplay', title: 'AirPlay', text: 'Send the video to AirPlay devices on macOS.' },
    ],
  },
  {
    name: 'Picture',
    items: [
      { icon: 'upscale', title: 'Upscaling', text: 'Videos below HD shown larger than they are get scaled up with AMD FSR 1 on the GPU.' },
      { icon: 'mini', title: 'Mini player', text: 'A small, resizable window that stays above other apps. Vertical videos get a vertical window.' },
      { icon: 'seek', title: 'Seek bar', text: 'Previews, chapters, torrent speed and peers.' },
    ],
  },
  {
    name: 'Privacy',
    items: [
      { icon: 'shield', title: 'Shield', text: 'Torrents go through the SOCKS5 proxy of your VPN provider, so peers do not see your address.' },
      { icon: 'trash', title: 'Nothing left on disk', text: 'Torrent data and converted segments are deleted when the app quits.' },
      { icon: 'code', title: 'Free software', text: 'GPL-3.0-or-later. No account, no tracking, no ads.' },
    ],
  },
];

const keys: [string[], string][] = [
  [['Space', 'K'], 'Play / pause'],
  [['←', '→', 'J', 'L'], 'Seek 10 s'],
  [['↑', '↓'], 'Volume'],
  [['M'], 'Mute'],
  [['F'], 'Full screen'],
  [['P'], 'Mini player'],
  [['U'], 'Upscaling'],
  [['V'], 'VR / 2D'],
];

const systems = [
  { os: 'mac', name: 'macOS', icon: 'laptop', detail: 'Apple Silicon and Intel · .dmg' },
  { os: 'win', name: 'Windows', icon: 'window', detail: '64-bit · installer' },
  { os: 'linux', name: 'Linux', icon: 'terminal', detail: 'AppImage · .deb · .rpm' },
] as const;
---

<Base
  title="Tonic Player"
  description="Video player for local files and torrents, streamed while they download, with Chromecast and AirPlay. Free software for macOS, Windows and Linux."
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top wrap">
    <a class="brand" href={base}>Tonic Player</a>
    <nav aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#keys">Keys</a>
      <a href="#download">Download</a>
      <a href={repo}>Source</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero wrap">
      <div class="bottle" id="bottle">
        <BottleArt class="fallback" />
        <canvas aria-hidden="true"></canvas>
      </div>
      <div class="pitch">
        <h1>Tonic Player</h1>
        <p class="lede">A video player for local files and torrents, streamed while they download, with Chromecast and AirPlay.</p>
        <ul class="systems" id="download" aria-label="Download">
          {
            systems.map((s) => (
              <li>
                <a class="system" data-os={s.os} href={latest}>
                  <Icon name={s.icon} />
                  <span class="what">
                    <strong>{s.name}</strong>
                    <small>{s.detail}</small>
                  </span>
                  <Icon name="download" />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="note">
          Free software, GPL-3.0-or-later · <a href={repo}>Source on GitHub</a>{' · '}<a href={`${repo}#install`}>Install notes</a>
        </p>
      </div>
    </section>

    <section class="wrap" aria-label="Demo">
      <Demo />
    </section>

    <section class="wrap" id="features">
      <h2>Features</h2>
      {
        groups.map((g) => (
          <div class="group">
            <h3>{g.name}</h3>
            <ul class="cards">
              {g.items.map((f) => (
                <li class="card">
                  <Icon name={f.icon} />
                  <div>
                    <strong>{f.title}</strong>
                    <p>{f.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="wrap" id="keys">
      <h2>Keyboard</h2>
      <ul class="keys">
        {
          keys.map(([ks, action]) => (
            <li>
              <span class="caps">{ks.map((k) => <kbd>{k}</kbd>)}</span>
              <span>{action}</span>
            </li>
          ))
        }
      </ul>
    </section>

  </main>

  <footer class="wrap foot">
    <p>Free software under <a href={`${repo}/blob/main/LICENSE`}>GPL-3.0-or-later</a> · <a href={repo}>source</a> · <a href={`${base}screensaver/`}>screensaver</a></p>
  </footer>

  <script>
    import { startHero } from '../scripts/hero';
    startHero();
  </script>
</Base>

<style is:global>
  .wrap {
    width: min(1040px, 100%);
    margin-inline: auto;
    padding: 0 var(--gutter);
  }
  .skip {
    position: absolute;
    left: 8px;
    top: -60px;
    padding: 0.5em 1em;
    background: var(--accent);
    color: var(--bg);
  }
  .skip:focus {
    top: 8px;
  }
  .icon {
    flex-shrink: 0;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5em 1.5em;
    padding-top: 1.5em;
    padding-bottom: 1.5em;
  }
  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .top nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.4em;
  }
  .top nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .top nav a:hover {
    color: var(--text);
  }

  main > section {
    margin-top: 5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: 2rem;
  }
  .bottle {
    display: grid;
    place-items: center;
    --art-px: clamp(7px, 1.05vw, 11px);
  }
  .bottle > * {
    grid-area: 1 / 1;
  }
  .bottle canvas {
    display: none;
  }
  .bottle.live canvas {
    display: block;
  }
  .bottle.live .fallback {
    visibility: hidden;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5em;
  }
  .lede {
    font-size: 1.15rem;
    max-width: 34ch;
  }
  .note {
    margin-top: 1.2em;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Downloads: one tile per system; the visitor's own comes first, filled. */
  .pitch ul.systems {
    max-width: 440px;
    margin-top: 2em;
    gap: 8px;
  }
  ul.systems li:has(.mine) {
    order: -1;
  }
  .system {
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.8em 1.1em;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .system:hover {
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .system .what {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .system small {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .system > .icon:last-child {
    color: var(--muted);
  }
  .system.mine {
    padding: 1em 1.2em;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .system.mine:hover {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }
  .system.mine small,
  .system.mine > .icon:last-child {
    color: rgb(15 16 14 / 0.7);
  }
  .system.mine strong::after {
    content: ' · your system';
    font-weight: 400;
    font-size: 0.85em;
  }

  ul.cards,
  ul.keys,
  ul.systems {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .group + .group {
    margin-top: 2rem;
  }
  .group h3 {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9em;
  }
  ul.cards {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .card {
    display: flex;
    gap: 0.9em;
    padding: 1.1em 1.2em;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: #4a4b45;
  }
  .card:hover .icon {
    color: var(--accent);
  }
  .card strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.2em;
  }
  .card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  ul.keys {
    grid-template-columns: repeat(4, max-content);
    gap: 14px 40px;
  }
  .keys li {
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.8em;
    color: var(--muted);
  }
  .caps {
    display: inline-flex;
    gap: 0.3em;
  }
  kbd {
    display: inline-block;
    min-width: 2em;
    padding: 0.1em 0.5em;
    font: 0.9em var(--mono);
    text-align: center;
    color: var(--text);
    background: var(--raised);
    border: 1px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 5px;
  }

  .foot {
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    ul.cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    ul.keys {
      grid-template-columns: repeat(2, max-content);
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
      margin-top: 1rem;
    }
    .lede {
      margin-inline: auto;
    }
    .pitch ul.systems {
      margin-inline: auto;
      width: 100%;
    }
    .bottle {
      --art-px: 7px;
    }
    main > section {
      margin-top: 3.5rem;
    }
  }
  @media (max-width: 560px) {
    ul.cards,
    ul.keys {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
